# ============================================================================
# Retention Copilot — Environment Configuration Template
# Copy this file to `.env` and populate your credentials before running live
# Snowflake or OpenAI API integrations. Never commit `.env` to version control!
# ============================================================================

# --- OpenAI API Configuration (for AI Action Briefs) ---
# If omitted or left empty, Retention Copilot automatically uses its
# deterministic, evidence-grounded template engine with 100% claim validation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Snowflake Data Warehouse Configuration ---
# Required only for live Snowflake cloud execution. When omitted, scripts use
# the local SQLite warehouse emulator (`data/warehouse/retention_warehouse.db`)
# for offline verification and schema validation.
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=RETENTION_SERVICE_USER
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=RETENTION_ANALYST_ROLE
SNOWFLAKE_WAREHOUSE=RETENTION_WH
SNOWFLAKE_DATABASE=RETENTION_COPILOT_DB
SNOWFLAKE_SCHEMA=ANALYTICS

# --- Application Settings ---
RETENTION_CONFIG_PATH=configs/config.yaml
RETENTION_RANDOM_SEED=42
